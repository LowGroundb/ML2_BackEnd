"{\n  \"openapi\": \"3.0.0\",\n  \"info\": {\n    \"title\": \"McFitness\",\n    \"version\": \"1.0.0\",\n    \"description\": \"REST API για την εφαρμογή παρακολούθησης φυσικής κατάστασης και διατροφής.\"\n  },\n  \"servers\": [\n    {\n      \"url\": \"http://localhost:8080/api\"\n    }\n  ],\n  \"components\": {\n    \"schemas\": {\n      \"User\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"userId\": {\n            \"type\": \"integer\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"email\": {\n            \"type\": \"string\"\n          },\n          \"age\": {\n            \"type\": \"integer\"\n          },\n          \"gender\": {\n            \"type\": \"string\"\n          },\n          \"weight\": {\n            \"type\": \"number\",\n            \"format\": \"float\"\n          },\n          \"height\": {\n            \"type\": \"number\",\n            \"format\": \"float\"\n          },\n          \"activityLevel\": {\n            \"type\": \"string\"\n          }\n        }\n      },\n      \"Goal\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"goalId\": {\n            \"type\": \"integer\"\n          },\n          \"goalType\": {\n            \"type\": \"string\"\n          },\n          \"targetWeight\": {\n            \"type\": \"number\",\n            \"format\": \"float\"\n          },\n          \"targerCalories\": {\n            \"type\": \"integer\"\n          },\n          \"targetProtein\": {\n            \"type\": \"number\",\n            \"format\": \"float\"\n          },\n          \"targetCarbs\": {\n            \"type\": \"number\",\n            \"format\": \"float\"\n          },\n          \"targetFat\": {\n            \"type\": \"number\",\n            \"format\": \"float\"\n          },\n          \"timePeriodWeeks\": {\n            \"type\": \"integer\"\n          }\n        }\n      },\n      \"Food\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"foodId\": {\n            \"type\": \"integer\"\n          },\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"caloriesPer100g\": {\n            \"type\": \"number\",\n            \"format\": \"float\"\n          },\n          \"proteinPer100g\": {\n            \"type\": \"number\",\n            \"format\": \"float\"\n          },\n          \"carbsPer100g\": {\n            \"type\": \"number\",\n            \"format\": \"float\"\n          },\n          \"fatPer100g\": {\n            \"type\": \"number\",\n            \"format\": \"float\"\n          }\n        }\n      },\n      \"Meal\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"mealId\": {\n            \"type\": \"integer\"\n          },\n          \"mealType\": {\n            \"type\": \"string\"\n          },\n          \"timestamp\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\"\n          },\n          \"totalCalories\": {\n            \"type\": \"number\",\n            \"format\": \"float\"\n          },\n          \"foods\": {\n            \"type\": \"array\",\n            \"items\": {\n              \"$ref\": \"#/components/schemas/Food\"\n            }\n          }\n        }\n      },\n      \"Exercise\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"exerciseId\": {\n            \"type\": \"integer\"\n          },\n          \"type\": {\n            \"type\": \"string\"\n          },\n          \"durationMinutes\": {\n            \"type\": \"integer\"\n          },\n          \"caloriesBurned\": {\n            \"type\": \"number\",\n            \"format\": \"float\"\n          },\n          \"timestamp\": {\n            \"type\": \"string\",\n            \"format\": \"date-time\"\n          }\n        }\n      }\n    }\n  },\n  \"paths\": {\n    \"/foods/search\": {\n      \"get\": {\n        \"summary\": \"Αναζήτηση τροφίμου\",\n        \"parameters\": [\n          {\n            \"name\": \"query\",\n            \"in\": \"query\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"string\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Done\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"type\": \"array\",\n                  \"items\": {\n                    \"$ref\": \"#/components/schemas/Food\"\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/user\": {\n      \"post\": {\n        \"summary\": \"Create new user\",\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/User\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"201\": {\n            \"description\": \"New User Created\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/User\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/user/{userId}\": {\n      \"put\": {\n        \"summary\": \"Update user profile\",\n        \"parameters\": [\n          {\n            \"name\": \"userId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/User\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Done\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/User\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"delete\": {\n        \"summary\": \"Διαγραφή Λογαριασμού Χρήστη\",\n        \"parameters\": [\n          {\n            \"name\": \"userId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"User deleted successfully\"\n          }\n        }\n      }\n    },\n    \"/users/{userId}/goals\": {\n      \"post\": {\n        \"summary\": \"Υπολογισμός και Αποθήκευση Στόχου\",\n        \"parameters\": [\n          {\n            \"name\": \"userId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/Goal\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Done\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/Goal\"\n                }\n              }\n            }\n          }\n        }\n      },\n      \"get\": {\n        \"summary\": \"Ανάκτηση Στόχου\",\n        \"parameters\": [\n          {\n            \"name\": \"userId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          }\n        ],\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Done\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/Goal\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/users/{userId}/meal\": {\n      \"post\": {\n        \"summary\": \"Καταγραφή Γεύματος\",\n        \"parameters\": [\n          {\n            \"name\": \"userId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/Meal\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Done\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/Meal\"\n                }\n              }\n            }\n          }\n        }\n      }\n    },\n    \"/users/{userId}/exercises\": {\n      \"post\": {\n        \"summary\": \"Καταγραφή Άσκησης\",\n        \"parameters\": [\n          {\n            \"name\": \"userId\",\n            \"in\": \"path\",\n            \"required\": true,\n            \"schema\": {\n              \"type\": \"integer\"\n            }\n          }\n        ],\n        \"requestBody\": {\n          \"required\": true,\n          \"content\": {\n            \"application/json\": {\n              \"schema\": {\n                \"$ref\": \"#/components/schemas/Exercise\"\n              }\n            }\n          }\n        },\n        \"responses\": {\n          \"200\": {\n            \"description\": \"Done\",\n            \"content\": {\n              \"application/json\": {\n                \"schema\": {\n                  \"$ref\": \"#/components/schemas/Exercise\"\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"